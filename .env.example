# Terence Media Hub configuration. Copy to .env and fill in real values.
# .env is git-ignored. Never commit real passwords or secrets.

# MySQL 8.4 (Homebrew), local only. Percent-encode special characters in the password
# (for example @ -> %40, # -> %23, / -> %2F, : -> %3A).
DATABASE_URL="mysql://tmh_app:CHANGE_ME@127.0.0.1:3306/terence_media_hub"

# FFmpeg / ffprobe (Homebrew build with VideoToolbox)
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Where uploaded files, thumbnails and previews are stored. Must be OUTSIDE the project folder.
# On the Mac mini this is the external SSD. The folder must contain the .tmh-storage marker file;
# the app refuses to run if it is missing (for example when the drive is unplugged), so it can
# never silently write into an empty /Volumes path on the internal disk.
STORAGE_ROOT="/Volumes/Extreme SSD/TMH-Media"

# Largest single upload, in bytes (10 GiB = 10737418240)
MAX_UPLOAD_BYTES=10737418240

# Random secret for signing session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Address people use to open the app, and the port it listens on
APP_ORIGIN=http://localhost:3000
PORT=3000
