# Terence Media Hub configuration. Copy to .env and fill in real values.
# .env is git-ignored. Never commit real passwords or secrets.

# MySQL 8.4 (Homebrew), local only. Percent-encode special characters in the password
# (for example @ -> %40, # -> %23, / -> %2F, : -> %3A, ? -> %3F, % -> %25).
# The live database stays on the Mac's internal disk (the SSD is exFAT, which is unsafe for a live database).
DATABASE_URL="mysql://tmh_app:CHANGE_ME@127.0.0.1:3306/terence_media_hub"

# Primary media storage on the external SSD. Must contain the .tmh-storage marker file;
# the app refuses to write if it is missing (for example when the drive is unplugged), so it can
# never silently write into an empty /Volumes path on the internal disk.
MEDIA_STORAGE_ROOT="/Volumes/Extreme SSD/TMH-Media"

# FFmpeg / ffprobe / mysqldump (Homebrew; FFmpeg built with VideoToolbox)
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe
MYSQLDUMP_PATH=/opt/homebrew/bin/mysqldump

# Largest single upload in bytes (10 GiB = 10737418240), and space always kept free on the SSD (5 GiB)
MAX_UPLOAD_BYTES=10737418240
STORAGE_RESERVE_BYTES=5368709120

# Random secret, generate with: openssl rand -base64 48 (reserved for signed links; sessions are stored in MySQL)
SESSION_SECRET=
# How long a sign-in lasts, in hours (default 7 days)
SESSION_TTL_HOURS=168

# Address people use to open the app, and the port the app (frontend + API together) listens on.
# Use https:// here only if the app is served over HTTPS (it makes session cookies Secure).
APP_ORIGIN=http://localhost:3000
PORT=3000

# How many database backups to keep in TMH-Media/database-backups (minimum 2)
BACKUP_KEEP=30

# Optional cloud storage (phase 2). Not required for the local MVP; no credentials needed today.
CLOUD_STORAGE_ENABLED=false
CLOUD_STORAGE_PROVIDER=
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_REGION=
CLOUD_STORAGE_ENDPOINT=
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=
