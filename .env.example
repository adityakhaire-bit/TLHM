# Terence Media Hub configuration. Copy to .env (repository root) and fill in real values.
# .env is git-ignored and shared by frontend/ (via the frontend/.env link) and backend/.
# NEVER commit .env, service-account JSON files or private keys.

# ---------- External SSD (primary media storage) ----------
# Must contain the .tmh-storage marker file (scripts/setup/init-storage.sh creates it).
# Without the marker, or when the drive is unplugged, uploads stop with a clear error;
# the app never falls back to the Mac's internal disk.
MEDIA_STORAGE_ROOT="/Volumes/Extreme SSD/TMH-Media"
# Optional overrides (default: inside MEDIA_STORAGE_ROOT; the temp dir must be on the same drive)
# UPLOAD_TEMP_DIR="/Volumes/Extreme SSD/TMH-Media/uploads-temp"
# LOG_DIR="/Volumes/Extreme SSD/TMH-Media/logs"
MAX_UPLOAD_BYTES=10737418240          # 10 GiB per file
STORAGE_RESERVE_BYTES=5368709120      # always keep 5 GiB free on the drive

# ---------- FFmpeg (Homebrew build with VideoToolbox) ----------
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# ---------- Backend (Express API) ----------
BACKEND_PORT=4000
BACKEND_HOST=127.0.0.1                # 0.0.0.0 to serve other computers on the office network
FRONTEND_ORIGIN=http://localhost:3000 # comma-separated list of allowed browser origins (CORS); never *

# ---------- Firebase ----------
# Web app config (Firebase Console > Project settings > Your apps). Public by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Backend (Firebase Admin SDK). The service-account JSON is SECRET: keep it outside the repository,
# readable only by your user (chmod 600).
FIREBASE_PROJECT_ID=your-project
GOOGLE_APPLICATION_CREDENTIALS="/Users/YOU/.config/terence-media-hub/firebase-service-account.json"
# Google sign-in: only verified Google accounts at these email domains may sign in (comma separated).
# New people start as "viewer"; admins change roles on the Users page. Empty = Google sign-in off.
ALLOWED_EMAIL_DOMAINS=yourcompany.com

# ---------- Frontend ----------
# Where the browser reaches the backend API. Empty = same origin (legacy Next.js API routes).
# Phase 2: NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=

# ---------- Optional cloud storage (future; not used by the MVP) ----------
CLOUD_STORAGE_ENABLED=false
CLOUD_STORAGE_PROVIDER=
CLOUD_STORAGE_BUCKET=
CLOUD_STORAGE_REGION=
CLOUD_STORAGE_ENDPOINT=
CLOUD_STORAGE_ACCESS_KEY=
CLOUD_STORAGE_SECRET_KEY=

# ---------- LEGACY (MySQL prototype; removed in Phase 2 after approval) ----------
DATABASE_URL="mysql://tmh_app:CHANGE_ME@127.0.0.1:3306/terence_media_hub"
MYSQLDUMP_PATH=/opt/homebrew/bin/mysqldump
APP_ORIGIN=http://localhost:3000
PORT=3000
SESSION_SECRET=

# Google Gemini (AI video analysis), paid/billing-enabled project only
GEMINI_API_KEY=
