{
  "name": "@tmh/backend",
  "version": "0.2.0",
  "private": true,
  "description": "TMH backend API: Express + TypeScript, local SSD storage, FFmpeg processing, Firebase Admin (Phase 2).",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tmh/shared": "*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  }
}
