// Terence Media Hub database schema (MySQL 8.4).
// Media binaries live on the SSD; this database holds metadata and file references only.
// Change it only through `npm run db:migrate:dev` (Prisma migrations), never by hand.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  admin
  editor
  viewer
}

enum MediaType {
  video
  audio
  image
}

enum ProcessingStatus {
  pending
  processing
  ready
  failed
}

enum UploadStatus {
  uploading
  complete
  failed
}

enum JobType {
  probe
  thumbnail
  proxy
  // AI video analysis (Gemini). Runs in its own worker lane; never changes the file's processing status.
  analyze
}

enum JobStatus {
  queued
  running
  completed
  failed
}

enum StorageType {
  local_ssd
  cloud
}

enum StorageKind {
  original
  proxy
  thumbnail
}

enum StorageStatus {
  available
  missing
}

enum BackupStatus {
  running
  succeeded
  failed
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(64)
  displayName  String    @default("") @map("display_name") @db.VarChar(120)
  // Null for accounts that only sign in with Google.
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  email        String?   @unique @db.VarChar(255)
  // Firebase Authentication UID for Google sign-in.
  firebaseUid  String?   @unique @map("firebase_uid") @db.VarChar(128)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(1024)
  role         Role      @default(viewer)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions Session[]
  uploads  MediaFile[]

  @@map("users")
}

model Session {
  // SHA-256 of the random session token; the raw token only ever lives in the user's cookie.
  id         String   @id @db.Char(64)
  userId     Int      @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Folder {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(120)
  parentId    Int?     @map("parent_id")
  description String?  @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Restrict: a folder with sub-folders or media cannot be deleted.
  parent   Folder?     @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Folder[]    @relation("FolderTree")
  media    MediaFile[]

  @@index([parentId, name])
  @@map("folders")
}

model MediaFile {
  id               String           @id @default(uuid()) @db.Char(36)
  title            String           @db.VarChar(255)
  originalFilename String           @map("original_filename") @db.VarChar(255)
  storedFilename   String           @map("stored_filename") @db.VarChar(128)
  mimeType         String           @map("mime_type") @db.VarChar(100)
  fileExtension    String           @map("file_extension") @db.VarChar(16)
  mediaType        MediaType        @map("media_type")
  fileSize         BigInt           @map("file_size")
  duration         Float?
  width            Int?
  height           Int?
  codec            String?          @db.VarChar(64)
  audioCodec       String?          @map("audio_codec") @db.VarChar(64)
  frameRate        Float?           @map("frame_rate")
  bitRate          Int?             @map("bit_rate")
  category         String?          @db.VarChar(100)
  description      String?          @db.Text
  folderId         Int?             @map("folder_id")
  // Paths are RELATIVE to MEDIA_STORAGE_ROOT so the SSD can be remounted or moved.
  originalPath     String           @map("original_path") @db.VarChar(512)
  proxyPath        String?          @map("proxy_path") @db.VarChar(512)
  proxySize        BigInt?          @map("proxy_size")
  thumbnailPath    String?          @map("thumbnail_path") @db.VarChar(512)
  thumbnailSize    BigInt?          @map("thumbnail_size")
  cloudProxyUrl    String?          @map("cloud_proxy_url") @db.VarChar(1024)
  checksum         String           @unique @db.Char(64)
  processingStatus ProcessingStatus @default(pending) @map("processing_status")
  uploadStatus     UploadStatus     @default(complete) @map("upload_status")
  probeData        Json?            @map("probe_data")
  uploadedById     Int?             @map("uploaded_by")
  deletedAt        DateTime?        @map("deleted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  folder           Folder?           @relation(fields: [folderId], references: [id], onDelete: Restrict)
  uploadedBy       User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  tags             MediaTag[]
  jobs             ProcessingJob[]
  storageLocations StorageLocation[]
  analysis         MediaAnalysis?

  @@index([folderId, createdAt])
  @@index([mediaType, createdAt])
  @@index([processingStatus])
  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("media_files")
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(64)
  createdAt DateTime   @default(now()) @map("created_at")
  media     MediaTag[]

  @@map("tags")
}

model MediaTag {
  mediaId String @map("media_id") @db.Char(36)
  tagId   Int    @map("tag_id")
  // "user" = added by a person; "ai" = added automatically from AI analysis (replaced on re-analysis).
  source  String @default("user") @db.VarChar(8)

  media MediaFile @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag   Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@index([tagId])
  @@map("media_tags")
}

model ProcessingJob {
  id           Int       @id @default(autoincrement())
  mediaId      String    @map("media_id") @db.Char(36)
  jobType      JobType   @map("job_type")
  status       JobStatus @default(queued)
  progress     Int       @default(0)
  attempts     Int       @default(0)
  errorMessage String?   @map("error_message") @db.Text
  runAfter     DateTime  @default(now()) @map("run_after")
  createdAt    DateTime  @default(now()) @map("created_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")

  media MediaFile @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([status, runAfter, id])
  @@index([mediaId])
  @@map("processing_jobs")
}

model StorageLocation {
  id          Int           @id @default(autoincrement())
  mediaId     String        @map("media_id") @db.Char(36)
  kind        StorageKind
  storageType StorageType   @map("storage_type")
  storagePath String        @map("storage_path") @db.VarChar(1024)
  status      StorageStatus @default(available)
  verifiedAt  DateTime?     @map("verified_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  media MediaFile @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, kind, storageType])
  @@map("storage_locations")
}

model Backup {
  id           Int          @id @default(autoincrement())
  filename     String       @db.VarChar(255)
  sizeBytes    BigInt?      @map("size_bytes")
  status       BackupStatus @default(running)
  trigger      String       @db.VarChar(32)
  errorMessage String?      @map("error_message") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  completedAt  DateTime?    @map("completed_at")

  @@index([status, createdAt])
  @@map("backups")
}

// ---------------------------------------------------------------------------------------------
// AI video analysis. One current analysis per media file; re-analysing replaces these rows.
// Everything here is derived data (it can always be regenerated from the original file).
// ---------------------------------------------------------------------------------------------

model MediaAnalysis {
  id              Int      @id @default(autoincrement())
  mediaId         String   @unique @map("media_id") @db.Char(36)
  model           String   @db.VarChar(64)
  pipelineVersion Int      @map("pipeline_version")
  summary         String   @db.Text
  suggestedTitle  String?  @map("suggested_title") @db.VarChar(255)
  setting         String?  @db.VarChar(120)
  indoorOutdoor   String?  @map("indoor_outdoor") @db.VarChar(16)
  language        String?  @db.VarChar(40)
  hasSpeech       Boolean  @default(false) @map("has_speech")
  hasMusic        Boolean  @default(false) @map("has_music")
  peopleCount     Int?     @map("people_count")
  tags            Json
  people          Json
  topics          Json
  // How speech is used ("talking to camera", "voice-over", "no speech"...), who says what, and the subjects talked about.
  speechType      String?  @map("speech_type") @db.VarChar(32)
  speechSummary   String?  @map("speech_summary") @db.Text
  spokenTopics    Json?    @map("spoken_topics")
  // Lower-case text of everything above, for fast file-level search.
  searchText      String   @map("search_text") @db.MediumText
  inputTokens     Int      @default(0) @map("input_tokens")
  outputTokens    Int      @default(0) @map("output_tokens")
  elapsedMs       Int      @default(0) @map("elapsed_ms")
  rawJson         Json     @map("raw_json")
  createdAt       DateTime @default(now()) @map("created_at")

  media      MediaFile           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  segments   VideoSegment[]
  attributes AnalysisAttribute[]
  transcript TranscriptLine[]

  @@map("media_analyses")
}

model VideoSegment {
  id             Int     @id @default(autoincrement())
  analysisId     Int     @map("analysis_id")
  mediaId        String  @map("media_id") @db.Char(36)
  startMs        Int     @map("start_ms")
  endMs          Int     @map("end_ms")
  description    String  @db.Text
  shotType       String? @map("shot_type") @db.VarChar(40)
  cameraMovement String? @map("camera_movement") @db.VarChar(40)
  setting        String? @db.VarChar(120)
  // Lower-case description + attributes (clothing, colours, actions, objects) of this segment, for moment search.
  searchText     String  @map("search_text") @db.Text

  analysis   MediaAnalysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  attributes AnalysisAttribute[]

  @@index([mediaId, startMs])
  @@index([analysisId])
  @@map("video_segments")
}

/// One structured detection: clothing, action, object, shot type, topic... with its time range.
model AnalysisAttribute {
  id           Int     @id @default(autoincrement())
  analysisId   Int     @map("analysis_id")
  mediaId      String  @map("media_id") @db.Char(36)
  segmentId    Int?    @map("segment_id")
  category     String  @db.VarChar(24)
  value        String  @db.VarChar(120)
  color        String? @db.VarChar(40)
  pattern      String? @db.VarChar(40)
  bodyRegion   String? @map("body_region") @db.VarChar(16)
  personLabel  String? @map("person_label") @db.VarChar(40)
  startMs      Int     @map("start_ms")
  endMs        Int     @map("end_ms")
  confidence   Float?
  source       String  @default("gemini") @db.VarChar(24)
  modelVersion String  @map("model_version") @db.VarChar(64)

  analysis MediaAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  segment  VideoSegment? @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([category, value])
  @@index([mediaId, category])
  @@index([analysisId])
  @@index([segmentId])
  @@map("analysis_attributes")
}

model TranscriptLine {
  id         Int     @id @default(autoincrement())
  analysisId Int     @map("analysis_id")
  mediaId    String  @map("media_id") @db.Char(36)
  startMs    Int     @map("start_ms")
  endMs      Int     @map("end_ms")
  speaker    String? @db.VarChar(40)
  text       String  @db.Text

  analysis MediaAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([mediaId, startMs])
  @@index([analysisId])
  @@map("transcript_lines")
}

/// Small app-wide switches an admin can change from the UI (e.g. office Wi-Fi guest access).
model AppSetting {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
